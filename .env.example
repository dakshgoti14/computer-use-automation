# --- LLM provider selection -------------------------------------------------
# Which LLMProvider implementation to use for the DISCOVERY phase only.
# The ReplayEngine never reads these values and never constructs a provider.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Demo application --------------------------------------------------------
DEMO_APP_HOST=127.0.0.1
DEMO_APP_PORT=8001
DEMO_APP_BASE_URL=http://127.0.0.1:8001

# --- Main API service ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Runtime behaviour --------------------------------------------------------
EVIDENCE_DIR=evidence
CAPABILITIES_DIR=capabilities
HEADLESS_BROWSER=true
AGENT_MAX_STEPS=20
REPLAY_MAX_RETRIES=2
LOG_LEVEL=INFO
